    <changeSet id="7" author="Wojtek">
        <dropForeignKeyConstraint baseTableName="company_expense" constraintName="fkf3fr3kkto7grwym2n34govr89"/>
        <dropUniqueConstraint tableName="company_expense" constraintName="uklr6athhuqys31rloxtl47fan0"/>
        <dropColumn tableName="company_expense" columnName="order_id"/>
        <dropColumn tableName="company_expense" columnName="invoice_number"/>

        <sql>
            ALTER TABLE company_expense DROP CONSTRAINT IF EXISTS company_expense_category_check;
            ALTER TABLE company_expense ADD CONSTRAINT company_expense_category_check
                CHECK (((category)::text = ANY ((ARRAY[
                    'RENT'::character varying,
                    'TAXES'::character varying,
                    'ZUS'::character varying,
                    'EQUIPMENT'::character varying,
                    'SALARY'::character varying,
                    'PRODUCTS'::character varying,
                    'SERVICES'::character varying,
                    'UNRELATED'::character varying,
                    'OTHER'::character varying])::text[])));
        </sql>

        <addColumn tableName="company_expense_item">
            <column name="product_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_expense_item_product"
                             referencedTableName="product"
                             referencedColumnNames="id"/>
            </column>
        </addColumn>
        <createIndex tableName="company_expense_item" indexName="idx_company_expense_item_product_id">
            <column name="product_id"/>
        </createIndex>

        <createView viewName="expense_unified" replaceIfExists="true">
            SELECT
                ('MANUAL-' || ce.id) AS unified_id,
                ce.id AS source_id,
                'MANUAL' AS source_type,
                ce.source AS source,
                ce.expense_date AS expense_date,
                ce.category AS category,
                CAST(ce.total_net AS NUMERIC(15,2)) AS total_net,
                CAST(ce.total_vat AS NUMERIC(15,2)) AS total_vat,
                CAST(ce.total_value AS NUMERIC(15,2)) AS total_value,
                CAST(false AS BOOLEAN) AS awaiting_product_verification,
                CAST(NULL AS VARCHAR) AS seller_default_expense_category,
                CAST(NULL AS VARCHAR) AS invoice_type
            FROM company_expense ce
            UNION ALL
            SELECT
                ('KSEF-' || ki.id) AS unified_id,
                ki.id AS source_id,
                'KSEF' AS source_type,
                ks.name AS source,
                ki.issue_date AS expense_date,
                ki.category AS category,
                CAST(ki.net_amount AS NUMERIC(15,2)) AS total_net,
                CAST(ki.vat_amount AS NUMERIC(15,2)) AS total_vat,
                CAST(ki.gross_amount AS NUMERIC(15,2)) AS total_value,
                ki.awaiting_product_verification AS awaiting_product_verification,
                ks.default_expense_category AS seller_default_expense_category,
                ki.invoice_type AS invoice_type
            FROM ksef_invoice ki
            JOIN ksef_seller ks ON ks.id = ki.seller_id
        </createView>

        <createView viewName="product_purchase" replaceIfExists="true">
            SELECT
                kii.product_id AS product_id,
                'KSEF' AS source_type,
                kii.id AS source_id,
                ki.issue_date AS purchase_date,
                CAST(COALESCE(kii.net_value / NULLIF(kii.declared_quantity, 0), kii.unit_net_price) AS NUMERIC(15,4)) AS unit_net_price,
                CAST(NULL AS NUMERIC(15,4)) AS unit_gross_price,
                kii.declared_quantity AS quantity,
                kii.vat_rate AS vat_rate
            FROM ksef_invoice_item kii
            JOIN ksef_invoice ki ON ki.id = kii.invoice_id
            WHERE kii.product_id IS NOT NULL
              AND kii.declared_quantity IS NOT NULL
              AND kii.declared_quantity > 0
            UNION ALL
            SELECT
                cei.product_id AS product_id,
                'MANUAL' AS source_type,
                cei.id AS source_id,
                ce.expense_date AS purchase_date,
                CAST(NULL AS NUMERIC(15,4)) AS unit_net_price,
                CAST(cei.price AS NUMERIC(15,4)) AS unit_gross_price,
                cei.quantity AS quantity,
                cei.vat_rate AS vat_rate
            FROM company_expense_item cei
            JOIN company_expense ce ON ce.id = cei.company_expense_id
            WHERE cei.product_id IS NOT NULL
              AND cei.quantity IS NOT NULL
              AND cei.quantity > 0
        </createView>
    </changeSet>

