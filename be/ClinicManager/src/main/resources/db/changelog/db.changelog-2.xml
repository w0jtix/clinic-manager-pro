    <changeSet id="14" author="Wojtek">
        <sql>
            UPDATE ksef_invoice_item SET
                unit_gross_price = ROUND(unit_net_price * CASE vat_rate
                    WHEN 'VAT_23' THEN 1.23 WHEN 'VAT_8' THEN 1.08 WHEN 'VAT_7' THEN 1.07
                    WHEN 'VAT_5' THEN 1.05 ELSE 1.00 END, 4),
                gross_value = ROUND(net_value * CASE vat_rate
                    WHEN 'VAT_23' THEN 1.23 WHEN 'VAT_8' THEN 1.08 WHEN 'VAT_7' THEN 1.07
                    WHEN 'VAT_5' THEN 1.05 ELSE 1.00 END, 2);
        </sql>
    </changeSet>

